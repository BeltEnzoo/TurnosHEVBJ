{
  "name": "sist-turnos-hep",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @hep/api --filter @hep/web --filter @hep/worker dev",
    "build": "pnpm --filter @hep/db generate && pnpm -r build",
    "lint": "pnpm -r --if-present lint",
    "typecheck": "pnpm --filter @hep/db generate && pnpm -r --if-present typecheck",
    "test": "pnpm --filter @hep/api test",
    "db:generate": "pnpm --filter @hep/db generate",
    "db:migrate": "pnpm --filter @hep/db migrate:dev",
    "db:migrate:deploy": "pnpm --filter @hep/db migrate:deploy",
    "db:seed": "pnpm --filter @hep/db seed",
    "demo:ui": "pnpm --filter @hep/web demo"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "argon2",
      "esbuild",
      "msgpackr-extract",
      "prisma"
    ]
  }
}
