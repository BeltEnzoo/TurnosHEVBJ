# Copiar a .env — nunca commitear valores reales.
NODE_ENV=development
APP_NAME="Sistema de Turnos"
HOSPITAL_NAME="Hospital Municipal"
PUBLIC_APP_URL=http://localhost:3000
API_URL=http://localhost:3001
API_PORT=3001
TZ=America/Argentina/Buenos_Aires

DATABASE_URL=postgresql://turnos:turnos_dev@localhost:5432/turnos_dev
REDIS_URL=redis://localhost:6379

# openssl / node crypto: >= 32 bytes en base64
SESSION_SECRET=dev-only-change-me-use-random-bytes-please-32b
FIELD_ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=

COOKIE_SECURE=false
COOKIE_SAMESITE=lax
TRUST_PROXY=false

TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

WHATSAPP_PROVIDER=mock
# Firma HMAC del webhook de estado. Vacío hasta configurar el entorno. Nunca commitear el valor real.
WHATSAPP_WEBHOOK_SECRET=

LOG_LEVEL=info
CORS_ALLOWED_ORIGINS=

ALLOW_DEV_SEED=true
SEED_ADMIN_EMAIL=admin@hospital.local
SEED_ADMIN_PASSWORD=DevAdmin1234!
SEED_ADMISION_EMAIL=admision@hospital.local
SEED_ADMISION_PASSWORD=AdmisionLocal1!
SEED_SISTEMAS_EMAIL=sistemas@hospital.local
SEED_SISTEMAS_PASSWORD=SistemasLocal1!
SEED_ADMINISTRACION_EMAIL=administracion@hospital.local
SEED_ADMINISTRACION_PASSWORD=Administracion1!

# Capa visual DEMO (frontend). Nunca true en production. Preferí `pnpm demo:ui`.
# NEXT_PUBLIC_DEMO_UI=true

# idle / absolute session (hours)
SESSION_IDLE_HOURS=8
SESSION_ABSOLUTE_HOURS=12
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
